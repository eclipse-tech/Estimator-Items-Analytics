# Environment variables for Docker Compose
# Copy this file to .env and modify as needed

# Application environment (local, dev, uat, prod)
env=dev

# SSH Tunnel Configuration
ENABLE_SSH_TUNNEL=1
SSH_PKEY_PATH=/run/secrets/shared-key.pem

# API Configuration
API_REQUEST_TIMEOUT=600
API_HOST_OVERRIDE=https://admin-portal.letsmultiply.app

# MySQL Configuration (for local development)
MYSQL_HOST_OVERRIDE=host.docker.internal
MYSQL_PORT_OVERRIDE=3306

# PEM file path on host (update this to your actual PEM file location)
# PEM_FILE_PATH=/Users/chayanchakraborty/Downloads/prod-db-jump-host.pem
